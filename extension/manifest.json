{
  "manifest_version": 3,
  "name": "Турбо ПВЗ → Закрытие",
  "description": "Сбор черновика закрытия смены с Турбо ПВЗ для Telegram-бота ПВЗ",
  "version": "0.2.28",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alwaysOnTopWindows"
  ],
  "host_permissions": [
    "https://turbo-pvz.ozon.ru/*",
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Турбо ПВЗ Закрытие",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://turbo-pvz.ozon.ru/*"],
      "js": [
        "content/selectors.js",
        "content/dom.js",
        "content/counts.js",
        "content/report-page.js",
        "content/tare.js",
        "content/carriages.js",
        "content/zasyl.js",
        "content/messages.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
